# Copiar a .env y completar. NO subir secretos de pasarela al repo.
# Firebase (cliente)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Maps / Routes
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloudinary (opcional; sin esto se usan URIs locales)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Backend local (IP de tu PC si pruebas en celular físico)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Mercado Pago Checkout Pro
EXPO_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# NUNCA en la app — solo server/.env o .env del backend
MERCADOPAGO_ACCESS_TOKEN=

# Stripe (opcional)
# STRIPE_SECRET_KEY=
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
